{
  "name": "carbsy",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-dev.mjs",
    "android": "npm start -- --android",
    "ios": "npm start -- --ios",
    "web": "npm start -- --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/*.test.mjs",
    "build:foods": "node scripts/build-food-db.mjs",
    "test:ui": "playwright test",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "format": "prettier --write src server tests scripts *.ts *.js *.json README.md",
    "test:ai": "playwright test -c playwright.ai.config.ts",
    "start:infisical": "node --env-file-if-exists=.env scripts/start-dev.mjs --infisical",
    "server:infisical": "node --env-file-if-exists=.env scripts/start-dev.mjs --infisical --server-only"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
