{
  "name": "carbsy",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-dev.mjs",
    "android": "npm start -- --android",
    "ios": "npm start -- --ios",
    "web": "npm start -- --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/*.test.mjs",
    "build:foods": "node scripts/build-food-db.mjs",
    "test:ui": "playwright test",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "format": "prettier --write src server tests scripts *.ts *.js *.json README.md",
    "test:ai": "playwright test -c playwright.ai.config.ts",
    "start:infisical": "node --env-file-if-exists=.env scripts/start-dev.mjs --infisical",
    "server:infisical": "node --env-file-if-exists=.env scripts/start-dev.mjs --infisical --server-only",
    "start:lan": "npm start -- --lan"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
