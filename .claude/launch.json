{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mock-service",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/mock-service.mjs"],
      "port": 3001
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_ANALYSIS_URL=http://localhost:3001",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
