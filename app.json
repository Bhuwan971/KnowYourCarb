{
  "expo": {
    "name": "Carbsy",
    "slug": "knowyourcarb",
    "scheme": "carbsy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.knowyourcarb.carbsy" },
    "android": {
      "package": "com.knowyourcarb.carbsy",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#EDE7FF" },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Carbsy · A little more clarity",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        { "cameraPermission": "Let Carbsy take a snap of your food.", "recordAudioAndroid": false }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a food photo for your Carbsy journal.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
