# Optional: the app works locally without AI. Copy this file to .env to enable estimates.
# On your phone use your computer's LAN IP, e.g. http://192.168.1.20:3001
EXPO_PUBLIC_ANALYSIS_URL=http://localhost:3001
# Server only. NEVER prefix this key with EXPO_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
# Local development only. Configure specific origins and authentication before hosting publicly.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
