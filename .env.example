# Plain local setup: copy this to .env and add your OpenRouter key.
# Infisical setup: store AI_PROVIDER, OPENROUTER_API_KEY and OPENROUTER_MODEL in Infisical.
# Start with npm run start:infisical; provider keys never need to be in this file.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional cheaper text model for USDA matching (defaults to OPENROUTER_MODEL).
# OPENROUTER_MATCH_MODEL=
# Optional: USDA Branded Foods for barcodes and branded search. Free key: https://fdc.nal.usda.gov/api-key-signup
# USDA_API_KEY=

# Non-secret Infisical configuration. infisical init links a local login to a project.
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/
# Machine identity / CI alternative to .infisical.json:
# INFISICAL_PROJECT_ID=your-project-id
# Use INFISICAL_API_URL for EU Cloud or self-hosting (see the setup guide).

# Optional direct Gemini provider: AI_PROVIDER=gemini and GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash
# Optional existing hosted photo service; unset for automatic local Wi-Fi connection.
# EXPO_PUBLIC_ANALYSIS_URL=https://your-photo-service.example
PORT=3001
# Extra local browser origins; the dev launcher also allows its selected preview port.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
